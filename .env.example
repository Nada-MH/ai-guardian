# ===================================================================
# AI Guardian — Global Environment Configuration Template
# Copy this file to .env and configure your local/production credentials.
# NEVER commit actual secrets or production keys to version control.
# ===================================================================

# Application Environment
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Backend API Gateway
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Security & Authentication (Generate secure secret: openssl rand -hex 32)
JWT_SECRET_KEY=your-secure-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Multi-Tenant Database & pgvector
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_guardian_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_guardian_db
POSTGRES_PORT=5432

# Redis Cache & Task Broker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Vector Database (Qdrant or pgvector)
VECTOR_DB_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Document Storage (local / s3 / minio)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads
S3_BUCKET_NAME=ai-guardian-docs
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# AI Model Providers (Set API keys as needed; platform includes deterministic fallback)
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GROQ_API_KEY=your-groq-api-key
GOOGLE_API_KEY=your-google-api-key

# Embeddings
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=1536
