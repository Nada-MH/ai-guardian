# ===================================================================
# AI Guardian API — Backend Environment Variables
# Copy to apps/api/.env and update values.
# ===================================================================

APP_NAME="AI Guardian"
APP_VERSION="2.4.0"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

HOST="0.0.0.0"
PORT=8000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_guardian_db"
REDIS_URL="redis://localhost:6379/0"

# JWT Authentication
JWT_SECRET_KEY="ai-guardian-dev-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Object Storage
STORAGE_BACKEND="local"
STORAGE_LOCAL_PATH="./uploads"
S3_BUCKET_NAME="ai-guardian-docs"
S3_ENDPOINT_URL=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# AI Providers
LLM_PROVIDER="openai"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""

# Embeddings & Vector DB
EMBEDDING_MODEL="text-embedding-3-large"
EMBEDDING_DIMENSION=1536
VECTOR_DB_PROVIDER="qdrant"
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""

# Celery
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Ingestion
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_EXTENSIONS=".pdf,.docx,.txt,.csv,.json"
