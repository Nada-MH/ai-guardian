# ===================================================================
# AI Guardian - Comprehensive Git Ignore
# ===================================================================

# Environment Variables & Secrets (CRITICAL: Never commit real keys)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env
!*.env.example
!.env.example

# Private Keys & Certificates
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.pkcs12
id_rsa
id_dsa
id_ed25519

# Python Artifacts & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.pytest_cache/

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.uv/

# Node.js & Web Frontend Artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Next.js Build Output
.next/
out/
.turbo/
.vercel/

# TypeScript & Test Cache
*.tsbuildinfo
next-env.d.ts

# IDEs & System Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Temporary Scratch & Artifacts
tmp/
temp/
.user_uploaded/
.system_generated/
scratch/
*.sqlite3
*.db
